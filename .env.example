# HeartCheck Web — Variables de entorno

# URL absoluta de la API (solo si no se usa el proxy relativo /api).
# IMPORTANTE: usar únicamente URLs HTTPS en producción.
VITE_API_BASE_URL=

# Forzar el uso de datos de prueba (true/false). Por defecto se usan cuando
# no hay sesión activa.
VITE_USE_MOCK_DATA=false

# Proxy de desarrollo de Vite: destino del backend (solo entorno local).
HEARTCHECK_API_PROXY_TARGET=http://heartcheckapi.runasp.net

# Solo para desarrollo local con certificados autofirmados: HEARTCHECK_API_PROXY_INSECURE=true
