# HeartCheck Web — Variables de entorno

# URL absoluta de la API. Prioridad máxima sobre el valor por defecto
# (http://heartcheckapi.runasp.net/api). Incluir siempre el sufijo /api.
# runasp.net NO sirve HTTPS (ERR_CONNECTION_RESET): por defecto HTTP y el CSP
# (sin upgrade-insecure-requests) mantiene el esquema original de la petición.
VITE_API_BASE_URL=http://heartcheckapi.runasp.net/api

# Forzar HTTPS del backend (solo si runasp.net llegara a exponer HTTPS).
# Tiene prioridad sobre VITE_API_BASE_URL.
VITE_API_BASE_URL_HTTPS=https://heartcheckapi.runasp.net/api

# En local se puede volver al proxy relativo de Vite con VITE_API_BASE_URL=/api
# IMPORTANTE: el CSP de index.html ya permite ambos esquemas (connect-src).

# Forzar el uso de datos de prueba (true/false). Por defecto se usan cuando
# no hay sesión activa.
VITE_USE_MOCK_DATA=false

# Proxy de desarrollo de Vite: destino del backend (solo entorno local).
HEARTCHECK_API_PROXY_TARGET=http://heartcheckapi.runasp.net

# Solo para desarrollo local con certificados autofirmados: HEARTCHECK_API_PROXY_INSECURE=true
